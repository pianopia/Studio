# Comma-separated client IPs allowed to use the app (see README security section).
ALLOWED_IPS=127.0.0.1,::1
# When behind your own reverse proxy (not Cloudflare/Vercel), set hop count so
# X-Forwarded-For is read from the right (1 = single nginx with proxy_add_x_forwarded_for).
# Leave unset or 0 to ignore X-Forwarded-For (recommended unless a proxy is guaranteed).
TRUSTED_PROXY_HOPS=0
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002
GEMINI_VIDEO_MODEL=veo-2.0-generate-001
VIDEO_POLL_INTERVAL_MS=5000
VIDEO_POLL_MAX_ATTEMPTS=36
APP_ORIGIN=http://localhost:3000
TURSO_DATABASE_URL=libsql://YOUR_DB.turso.io
TURSO_AUTH_TOKEN=YOUR_TOKEN
